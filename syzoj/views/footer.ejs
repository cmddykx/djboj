</div>
<script data-cfasync="false" src="<%- lib('semantic-ui/2.4.1/semantic.min.js') %>"></script>
<script src="<%- lib('Chart.js/2.7.3/Chart.bundle.min.js') %>"></script>
<script src="<%- selfLib('script.js') %>?20170710"></script>
<script>
$(function () {
  $('pre').each(function () {
    var pre = $(this);
    pre.css('position', 'relative');
 
    var btn = $('<button>')
      .text('复制')
      .css({
        display: 'none',
        position: 'absolute',
        top: '0px',
        right: '0px',
        padding: '2px 8px',
        fontSize: '12px',
        cursor: 'pointer',
        background: '#fff',
        border: '1px solid #ccc',
        borderRadius: '4px',
        opacity: '0.85',
        zIndex: '10'
      })
      .click(function () {
        var code = pre.find('code').text() || pre.text();
        navigator.clipboard.writeText(code).then(function () {
          btn.text('已复制');
          setTimeout(function () { btn.text('复制'); }, 1500);
        });
      });
 
    pre.append(btn);
 
    pre.hover(
      function () { btn.fadeIn(150); },
      function () { btn.fadeOut(150); }
    );
 
    var lineCount = (pre.text().match(/\n/g) || []).length;
  });
});
</script>
</body>
</html>
